		<region region-id="642" left="72" top="1009.5" width="169.5" height="45.75" align-x="108.75" align-y="1026" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">Mlrs</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">z</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">k</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">root</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:derivative/>
										<ml:lambda>
											<ml:boundVars>
												<ml:id xml:space="preserve">z</ml:id>
											</ml:boundVars>
											<ml:apply>
												<ml:id xml:space="preserve">LRS</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">z</ml:id>
													<ml:id xml:space="preserve">ec</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:lambda>
									</ml:apply>
									<ml:id xml:space="preserve">z</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:localDefine>
						<ml:return>
							<ml:id xml:space="preserve">k</ml:id>
						</ml:return>
					</ml:program>
				</ml:define>
			</math>
