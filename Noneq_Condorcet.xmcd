		<region region-id="641" left="72" top="1077" width="70.5" height="12.75" align-x="93" align-y="1086" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">kml</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">Mlrs</ml:id>
						<ml:apply>
							<ml:mult/>
							<ml:real>2</ml:real>
							<ml:id xml:space="preserve">kl</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="26"/>
		</region>
		<region region-id="639" left="18" top="1125" width="226.5" height="64.5" align-x="65.25" align-y="1134" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">lnN</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">k</ml:id>
							<ml:id xml:space="preserve">ec</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:lessThan/>
								<ml:id xml:space="preserve">k</ml:id>
								<ml:id xml:space="preserve">kl</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">ln</ml:id>
								<ml:id xml:space="preserve">N0</ml:id>
							</ml:apply>
						</ml:ifThen>
						<ml:otherwise>
							<ml:parens>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:id xml:space="preserve">ln</ml:id>
										<ml:id xml:space="preserve">N0</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:integral auto-algorithm="true" algorithm="adaptive"/>
										<ml:lambda>
											<ml:boundVars>
												<ml:id xml:space="preserve">z</ml:id>
											</ml:boundVars>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">G</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">z</ml:id>
														<ml:id xml:space="preserve">ec</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:id xml:space="preserve">μ</ml:id>
											</ml:apply>
										</ml:lambda>
										<ml:bounds>
											<ml:id xml:space="preserve">kl</ml:id>
											<ml:id xml:space="preserve">k</ml:id>
										</ml:bounds>
									</ml:apply>
								</ml:apply>
							</ml:parens>
						</ml:otherwise>
					</ml:program>
				</ml:define>
			</math>
			<rendering item-idref="27"/>
		</region>
