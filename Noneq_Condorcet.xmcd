		<region region-id="717" left="6" top="3434.25" width="88.5" height="27.75" align-x="51.75" align-y="3450" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define warning="WarnRedefinedUDFunction" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">LRS</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">n</ml:id>
							<ml:id xml:space="preserve">k</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:id xml:space="preserve">B</ml:id>
							<ml:sequence>
								<ml:id xml:space="preserve">n</ml:id>
								<ml:id xml:space="preserve">k</ml:id>
							</ml:sequence>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">M</ml:id>
							<ml:sequence>
								<ml:id xml:space="preserve">n</ml:id>
								<ml:id xml:space="preserve">k</ml:id>
							</ml:sequence>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="47"/>
		</region>
		<region region-id="823" left="180" top="3446.25" width="213.75" height="12" align-x="180" align-y="3456" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>LRS =1 at the equilibrium population size N* </b>
				</p>
			</text>
		</region>
		<region region-id="719" left="6" top="3483" width="115.5" height="12.75" align-x="41.25" align-y="3492" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define warning="WarnRedefinedUDFunction" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">G</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">n</ml:id>
							<ml:id xml:space="preserve">k</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:minus/>
						<ml:apply>
							<ml:id xml:space="preserve">B</ml:id>
							<ml:sequence>
								<ml:id xml:space="preserve">n</ml:id>
								<ml:id xml:space="preserve">k</ml:id>
							</ml:sequence>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">M</ml:id>
							<ml:sequence>
								<ml:id xml:space="preserve">n</ml:id>
								<ml:id xml:space="preserve">k</ml:id>
							</ml:sequence>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="48"/>
		</region>
		<region region-id="822" left="180" top="3482.25" width="247.5" height="12" align-x="180" align-y="3492" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Growth rate=0 at the </b>
					<b>equilibrium population size N*</b>
					<b>
						<sp/>
					</b>
				</p>
			</text>
		</region>
		<region region-id="780" left="6" top="3518.25" width="134.25" height="27.75" align-x="33" align-y="3534" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define warning="WarnRedefinedBIUnit" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">N</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">k</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:id xml:space="preserve">root</ml:id>
						<ml:sequence>
							<ml:apply>
								<ml:id xml:space="preserve">G</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:id xml:space="preserve">k</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:id xml:space="preserve">n</ml:id>
							<ml:id xml:space="preserve">eb</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve">R</ml:id>
								<ml:id xml:space="preserve">em</ml:id>
							</ml:apply>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="49"/>
		</region>
		<region region-id="821" left="180" top="3524.25" width="158.25" height="12" align-x="180" align-y="3534" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<b>Equilibrium population size N*(k)</b>
					<b>
						<sp/>
					</b>
				</p>
			</text>
		</region>
		<region region-id="824" left="180" top="3566.25" width="225" height="24" align-x="180" align-y="3576" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>The level of equality at which the population size reaches its maximum</b>
				</p>
			</text>
		</region>
		<region region-id="792" left="6" top="3565.5" width="137.25" height="29.25" align-x="32.25" align-y="3582" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">kmax</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">root</ml:id>
						<ml:sequence>
							<ml:apply>
								<ml:derivative/>
								<ml:lambda>
									<ml:boundVars>
										<ml:id xml:space="preserve">k</ml:id>
									</ml:boundVars>
									<ml:apply>
										<ml:id xml:space="preserve">N</ml:id>
										<ml:id xml:space="preserve">k</ml:id>
									</ml:apply>
								</ml:lambda>
							</ml:apply>
							<ml:id xml:space="preserve">k</ml:id>
							<ml:id xml:space="preserve">eb</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve">R</ml:id>
								<ml:id xml:space="preserve">em</ml:id>
							</ml:apply>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="50"/>
		</region>
		<region region-id="919" left="6" top="3726.75" width="218.25" height="14.25" align-x="6" align-y="3738" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<f size="12">
						<b>2.3 Transient Malthusian </b>
					</f>
					<f size="12">
						<b>model (plots) </b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="1063" left="12" top="3756" width="332.25" height="230.25" align-x="12" align-y="3756" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<plot disable-calc="false" item-idref="51"/>
			<rendering item-idref="52"/>
		</region>
		<region region-id="1095" left="12" top="3998.25" width="411" height="48" align-x="12" align-y="4008" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Note:</b> As equality increases, the population becomes increasingly density-independent within the interval [<b>R/eb</b>,<b>R/em</b>]. This means it can have any population size within this interval with nearly equal probability. In this case, it is more appropriate to use the term "equilibrium population interval" rather than "equilibrium point".</p>
			</text>
		</region>
		<region region-id="1097" left="48" top="4062" width="303" height="236.25" align-x="48" align-y="4062" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<plot disable-calc="false" item-idref="53"/>
			<rendering item-idref="54"/>
		</region>
		<region region-id="1101" left="6" top="4304.25" width="423" height="24" align-x="6" align-y="4314" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Note</b>: In equilibrium-based models (i.e., where B(n,k) ≈ M(n,k) always holds), there is an optimal level of equality <b>kmax</b> at which the population reaches its maximum size.</p>
			</text>
		</region>
		<region region-id="1027" left="6" top="4350.75" width="246.75" height="14.25" align-x="6" align-y="4362" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<f size="12">
						<b>3.1 Malthusian model (</b>
					</f>
					<f family="Times New Roman" charset="0" size="12">
						<b>R(N)=εr*ln(N), </b>
					</f>
					<f family="Times New Roman" charset="0" size="12">
						<b>μ(k)=0</b>
					</f>
					<f size="12">
						<b>)</b>
					</f>
					<f size="12">
						<b>
							<sp/>
						</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="938" left="6" top="4386" width="332.25" height="86.25" align-x="6" align-y="4386" show-border="true" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
