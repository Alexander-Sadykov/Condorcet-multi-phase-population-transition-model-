		<region region-id="1104" left="12" top="5498.25" width="371.25" height="24" align-x="12" align-y="5508" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Note</b>: An equilibrium arises given any sublinear relationship between the resource and the population size. Under these conditions, the results remain qualitatively the same.</p>
			</text>
		</region>
	</regions>
