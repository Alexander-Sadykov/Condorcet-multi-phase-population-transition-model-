		<region region-id="927" left="6" top="3302.25" width="346.5" height="12" align-x="6" align-y="3312" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The free variables <b>k</b> and <b>n</b> represent the level of equality and the population size.</p>
			</text>
		</region>
		<region region-id="812" left="6" top="3330.75" width="258.75" height="14.25" align-x="6" align-y="3342" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
